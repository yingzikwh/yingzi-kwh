{
  "name": "yingzi-kwh",
  "version": "1.0.0",
  "description": "影子kwh - A CLI AI coding agent inspired by Claude Code, with web terminal and cover splash",
  "main": "src/launcher.js",
  "bin": {
    "yingzi-kwh": "./bin/yingzi-kwh.js",
    "kwh": "./bin/yingzi-kwh.js"
  },
  "scripts": {
    "start": "node bin/yingzi-kwh.js",
    "server": "node src/server.js",
    "build:exe": "node build-exe.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding",
    "llm",
    "deepseek",
    "qwen",
    "yingzi-kwh"
  ],
  "author": "影子kwh Team",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "diff": "^9.0.0",
    "simple-git": "^4.1.0"
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "assets/**/*"
    ],
    "targets": [
      "node24-win-x64"
    ],
    "outputPath": "dist"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.26.0",
    "jimp": "^1.7.0",
    "png-to-ico": "^3.0.2",
    "resedit": "^3.1.1"
  }
}
